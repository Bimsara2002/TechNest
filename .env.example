# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored. Only VITE_-prefixed vars reach the client bundle.

# Supabase project settings -> API.
#
# The URL is the project base and NOTHING else - no /rest/v1, no trailing
# slash. supabase-js appends its own paths, so a URL ending in /rest/v1 sends
# every query to /rest/v1/rest/v1/... and every sign-in to /rest/v1/auth/v1/...,
# which fails with "Invalid path specified in request URL" and looks like a
# broken key rather than a broken URL.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The anon / publishable key (sb_publishable_... or the older eyJ... JWT).
# Public by design: Row Level Security is what protects the data.
VITE_SUPABASE_ANON_KEY=your-anon-key

# Never add a service-role key here - anything VITE_-prefixed ships publicly.
